# Copy this file to .env for local `netlify dev` use.
# In production, set these in Netlify: Site configuration > Environment variables.
# Never commit the real .env file.

# Airtable — Developer Hub > Personal access tokens
# Scopes needed: data.records:read, data.records:write, schema.bases:read
# Access: this one base only
AIRTABLE_PAT=
AIRTABLE_BASE_ID=app3WA0xCNH9axTRV

# Stripe — Developers > API keys (use test mode keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS) — used later once wired into Airtable/automations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Admin hub password gate (Phase 1 simple gate — see public/admin)
ADMIN_PASSWORD=
